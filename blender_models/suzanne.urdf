<?xml version="1.0"?>
<!--
  Suzanne URDF, sized to ~1m (matches PyBullet's default cube.urdf),
  mass 1 kg. Inertia computed from mesh geometry, then scaled to mass.
-->
<robot name="suzanne">
  <link name="base_link">
    <contact>
      <lateral_friction value="0.6"/>
      <rolling_friction value="0.001"/>
      <contact_cfm value="0.0"/>
      <contact_erp value="1.0"/>
    </contact>
    <inertial>
      <origin rpy="0 0 0" xyz="0.0 0.08311 0.02552"/>
      <mass value="1.0"/>
      <inertia ixx="3.856e-02"
               iyy="4.338e-02"
               izz="3.912e-02"
               ixy="0.0"
               ixz="0.0"
               iyz="5.355e-03"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="suzanne.obj" scale="0.377092 0.377092 0.377092"/>
      </geometry>
      <material name="wood">
        <color rgba="0.55 0.35 0.20 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="suzanne.obj" scale="0.377092 0.377092 0.377092"/>
      </geometry>
    </collision>
  </link>
</robot>
